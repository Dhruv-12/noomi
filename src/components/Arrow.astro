---
// Authored wayfinding arrow. Square caps, one stroke weight everywhere.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class:list={['arrow', className]} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  <path d="M3 12h16M13 5.5 19.5 12 13 18.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" />
</svg>

<style>
  .arrow { flex: none; width: 1.25em; height: 1.25em; }
</style>
