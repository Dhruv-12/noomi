---
// Quantity stepper. Two modes share one look:
//   for="id"  a product-card stepper (local quantity before adding)
//   line      inside a cart line template (buttons carry data-act)
interface Props { for?: string; name?: string; line?: boolean }
const { for: id, name = 'product', line = false } = Astro.props;
---
{line ? (
  <div class="stepper" role="group" aria-label="Quantity">
    <button type="button" class="stepper__btn" data-act="dec" aria-label="Decrease quantity">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg>
    </button>
    <output class="stepper__n" data-f="qty" aria-live="polite">1</output>
    <button type="button" class="stepper__btn" data-act="inc" aria-label="Increase quantity">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg>
    </button>
  </div>
) : (
  <div class="stepper" role="group" aria-label={`Quantity of ${name}`} data-qty-for={id} data-qty="1">
    <button type="button" class="stepper__btn" data-step="dec" aria-label={`Decrease quantity of ${name}`} disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg>
    </button>
    <output class="stepper__n" data-qty-value aria-live="polite">1</output>
    <button type="button" class="stepper__btn" data-step="inc" aria-label={`Increase quantity of ${name}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg>
    </button>
  </div>
)}

<style>
  .stepper {
    display: inline-grid;
    grid-template-columns: 44px minmax(2.25rem, auto) 44px;
    align-items: center;
    height: var(--stepper-h, 44px);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 35%, transparent);
  }
  .stepper__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 200ms var(--ease-out), opacity 200ms;
  }
  .stepper__btn svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: square; }
  .stepper__btn:hover:not(:disabled) { background: color-mix(in srgb, currentColor 8%, transparent); }
  .stepper__btn:active:not(:disabled) { background: color-mix(in srgb, currentColor 14%, transparent); }
  .stepper__btn:disabled { opacity: 0.3; cursor: default; }
  .stepper__btn:focus-visible { outline-offset: -3px; }
  .stepper__n { text-align: center; font-weight: 650; font-variant-numeric: tabular-nums; }
</style>
